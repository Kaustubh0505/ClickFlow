{
  "manifest_version": 3,
  "name": "ClickFlow",
  "version": "0.2.0",
  "description": "Complete plans, verified browser actions, explicit website access and action confirmation.",
  "minimum_chrome_version": "120",
  "permissions": ["sidePanel", "activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": { "default_title": "Open ClickFlow" },
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:3001" }
}
