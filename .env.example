# Backend only. Never use VITE_ prefixes for secrets.
MODEL_API_KEY=
MODEL_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=nvidia/nemotron-3.5-super-vl:free
PORT=3001
# Relative to the repository root; runtime files are ignored by Git.
DATA_DIR=.data
# Backend-only deadline includes capability checks and retries.
MODEL_TIMEOUT_MS=60000
MODEL_MAX_RETRIES=2
# Phase 4 panel planning and one-step fixture execution require the separate .data/extension-token.
